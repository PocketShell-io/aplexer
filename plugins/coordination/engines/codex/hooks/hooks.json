{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__APLEXER_BIN__ context hook --engine codex || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__APLEXER_BIN__ context hook --engine codex || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__APLEXER_BIN__ context hook --engine codex || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

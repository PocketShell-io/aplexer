{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aplexer.local/schema/consumer-contract-v1.json",
  "title": "aplexer consumer contract v1",
  "description": "One entry per command Hub or PocketShell drives. CI runs every case against the built binary; a missing command or flag blocks release (F5).",
  "type": "object",
  "required": ["consumer", "version", "source", "cases"],
  "properties": {
    "consumer": {"type": "string", "enum": ["hub", "pocketshell"]},
    "version": {"const": 1},
    "source": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "command", "flags", "source"],
        "properties": {
          "id": {"type": "string"},
          "command": {"type": "string"},
          "flags": {"type": "array", "items": {"type": "string"}},
          "source": {"type": "string"},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
